PORT=7300
API_KEY=
RATE_LIMIT=100
RATE_WINDOW=60
MAX_BODY_SIZE=1M
MAX_ADDRESS_LENGTH=1000
ADDRESS_DB_PATH=db/address.db
LOCATION_DB_PATH=db/location.db
DB_MAX_OPEN_CONNS=10
LOCATION_SOURCE_CODE=kemendagri
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://samaita.com,https://api.samaita.com
ENABLE_STORE_REQUEST=false #store request and response to address.db, for analytic
# GOOGLE_MAPS_API_MOCK on true read from sqlite instead of calling google maps api.
# If mock disabled, it WILL call google maps api and lazy caching.
# If mock enabled, it WILL NOT call google maps api. If not found, will fake a response with 404.
GOOGLE_MAPS_API_MOCK=true 
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BASE_URL=https://geocode.googleapis.com/v4/geocode/address